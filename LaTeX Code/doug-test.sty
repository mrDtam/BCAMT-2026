        && && \textrm{Ans: }& \hbox to 5cm{\hrulefill}%
    \end{flalign*}%
}
\newcommand{\drawangle}[4][0.8]{%
    \tkzFindAngle(#2,#3,#4)%
    \tkzGetAngle{myAngle}%
    \tkzLabelAngle[pos=#1](#2,#3,#4){\footnotesize $\fpeval{round(\myAngle)}^\circ$}%
}
\newcommand{\drawright}[3][0]{%
    % #1 = rotation angle (optional, default=0)
    % #2 = horizontal leg length
    % #3 = vertical leg length
    \begin{scope}[rotate=#1]
        % Calculate scale factor to fit in 5x5 box
        \pgfmathsetmacro{\maxdim}{max(#2, #3, sqrt((#2)^2 + (#3)^2))}
        \pgfmathsetmacro{\scalefactor}{5/\maxdim}
        
        % Scale the coordinates
        \coordinate (B) at (0,0);
        \coordinate (A) at ({#2*\scalefactor},0);
        \coordinate (C) at (0,{#3*\scalefactor});
        \draw[thick] (A) -- (B) -- (C) -- cycle;
    \end{scope}%
}
\newcommand{\labelside}[4][]{%
    \node[#1] at ($(#2)!0.5!(#3)$) {#4};%
}
\newcommand{\drawanytriangle}[4][0]{%
    \begin{scope}[rotate=#1]
        % Check triangle inequality
        \pgfmathsetmacro{\valid}{and(and(#2+#3>#4, #2+#4>#3), #3+#4>#2)}
        \ifdim\valid pt=1pt
            % Calculate scale factor to fit in 5x5
            \pgfmathsetmacro{\maxdim}{max(#2, #3, #4)}
            \pgfmathsetmacro{\scalefactor}{5/\maxdim}
            
            % Scale all sides
            \pgfmathsetmacro{\scaledA}{#2*\scalefactor}
            \pgfmathsetmacro{\scaledB}{#3*\scalefactor}  
            \pgfmathsetmacro{\scaledC}{#4*\scalefactor}
            
            % Calculate angle using Law of Cosines (with scaled sides)
            \pgfmathsetmacro{\angle}{acos((\scaledA^2 + \scaledB^2 - \scaledC^2)/(2*\scaledA*\scaledB))}
            
            % Draw triangle
            \coordinate (A) at (0,0);
            \coordinate (B) at (\scaledA,0);
            \coordinate (C) at ({\angle}:{\scaledB});
            \draw[thick] (A) -- (B) -- (C) -- cycle;
        \else
            \node[red] at (2.5,2.5) {Invalid triangle!};
            \draw[red] (0,0) rectangle (5,5);
        \fi
    \end{scope}%
}
\newcommand{\drawquad}[6][blue]{%
    \draw[smooth,thick,<->, #1, variable=\x, domain=#5:#6] plot (\x,{#2*(\x-#3)^2+#4});
}
\newcommand{\drawaxis}[4]{%
    % Clip with a 0.8 buffer so labels and arrows are safe
    \clip (#1-1.2, #3-1.2) rectangle (#2+1.2, #4+1.2);    
    \draw[<->,thick] (#1,0) -- (#2,0) node[right] {$x$}; % x-axis
    \draw[<->,thick] (0,#3) -- (0,#4) node[above right] {$y$}; % y-axis
}

\newcommand{\drawgaxis}[4]{%
    % Clip with a 0.8 buffer
    \clip (#1-1.2, #3-1.2) rectangle (#2+1.2, #4+1.2);
    
    \draw[<->,thick] (#1,0) -- (#2,0) node[right] {$x$}; % x-axis
    \draw[<->,thick] (0,#3) -- (0,#4) node[above right] {$y$}; % y-axis
    \draw[opacity=0.3] (#1,#3) grid (#2,#4);
}
